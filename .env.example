# =============================================================================
# SRM Bats — production container environment (docker-compose.prod.yml)
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real secrets.
# Replace every <SERVER_PUBLIC_HOST> with the server's public IP or hostname.
# =============================================================================

# ---- Public HTTPS deployment (reverse proxy: docker-compose.proxy.yml) ------
# Only used when deploying behind Caddy for automatic HTTPS. Set your domain and
# an email for Let's Encrypt, add DNS A records for shop.<DOMAIN> + api.<DOMAIN>,
# then use the https:// values shown against FRONTEND_URL, NEXT_PUBLIC_API_URL
# and NEXTAUTH_URL below (they REPLACE the http://<SERVER_PUBLIC_HOST>:PORT ones).
#   storefront → https://shop.<DOMAIN>        api → https://api.<DOMAIN>
# Ignore this block if you run docker-compose.prod.yml alone (raw HTTP, no TLS).
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ---- PostgreSQL (postgres service) ------------------------------------------
POSTGRES_USER=srmbats
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=srm_bats

# ---- Database connection (API runtime + migrations) -------------------------
# Host MUST be the compose service name "postgres"; creds MUST match POSTGRES_* above.
DATABASE_URL=postgresql://srmbats:change-me-strong-db-password@postgres:5432/srm_bats

# ---- API (apps/api) runtime -------------------------------------------------
PORT=3001
# Public origin of the web app — used for CORS. Must match how browsers reach web.
FRONTEND_URL=http://<SERVER_PUBLIC_HOST>:3000
# HTTPS (proxy) — use your real domain instead, e.g.:  FRONTEND_URL=https://shop.example.com
JWT_SECRET=change-me-jwt-access-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
# Razorpay — the SECRET stays server-side only, never a NEXT_PUBLIC_* var.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=change-me-razorpay-secret
# Seeded admin user (created idempotently by the migrate service).
ADMIN_EMAIL=admin@srmbats.com
ADMIN_PASSWORD=change-me-admin-password

# ---- Web (apps/web) BUILD args — inlined into the image at build time -------
# Public URL the BROWSER uses to reach the API. Rebuild the web image if this changes.
NEXT_PUBLIC_API_URL=http://<SERVER_PUBLIC_HOST>:3001
# HTTPS (proxy) — use your real domain instead, e.g.:  NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# ---- Web (apps/web) runtime -------------------------------------------------
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://<SERVER_PUBLIC_HOST>:3000
# HTTPS (proxy) — use your real domain instead, e.g.:  NEXTAUTH_URL=https://shop.example.com
# Write full literal URLs here (env_file values are NOT variable-expanded — ${DOMAIN}
# would be passed through verbatim). DOMAIN/ACME_EMAIL above are only interpolated into
# the compose YAML (the caddy service + network aliases), where expansion does happen.
# Note: NextAuth's server-side login (authorize()) reaches the API via NEXT_PUBLIC_API_URL.
# On the raw stack that is <SERVER_PUBLIC_HOST>:3001; behind the proxy it is
# https://api.<your-domain>, which resolves to Caddy inside the compose network (see
# docker-compose.proxy.yml) and terminates TLS there.

# ---- Optional / legacy (currently UNUSED by the active auth stack) ----------
# The active NextAuth (v5 beta) uses NEXTAUTH_SECRET + credentials login above.
# Kept for reference in case Google OAuth is re-enabled on the retired pages.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
