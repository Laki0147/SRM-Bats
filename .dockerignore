# Build context excludes — keep images small and free of host state/secrets.

# Dependencies & build output (reinstalled/rebuilt inside the image)
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.turbo
**/*.tsbuildinfo

# VCS & tooling
.git
.gitignore
.github
.claude
.codex
.agents
.bob
.vscode
.idea

# Env files — provided at runtime via compose env_file / build args, never baked
**/.env*

# Uploaded content (persisted via a named volume, not the image)
apps/api/uploads

# Tests / logs / OS cruft
coverage
**/coverage
*.log
npm-debug.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# Docs & local references
docs/CREDENTIALS.local.md
*.local.md
*.secrets.md
